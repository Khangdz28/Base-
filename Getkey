local SCAN_INTERVAL = 3 -- đổi số này để thay đổi tốc độ quét
local lastResults = {}

local function resultsChanged(new)
    if #new ~= #lastResults then return true end
    for i, pet in ipairs(new) do
        if not lastResults[i] then return true end
        if pet.name ~= lastResults[i].name
        or pet.gen  ~= lastResults[i].gen then
            return true
        end
    end
    return false
end

task.spawn(function()
    while true do
        local results = scanPets()

        -- Chỉ print khi có thay đổi
        if resultsChanged(results) then
            lastResults = results

            print("═══════════════════════════════════")
            print("🐾 PET SCANNER — " .. #results .. " pets found")
            print("═══════════════════════════════════")

            if #results == 0 then
                print("  Không tìm thấy pet nào trong tầm!")
            else
                for i, pet in ipairs(results) do
                    local line = string.format(
                        "[%d] %-25s | Gen: %-10s | Rarity: %-10s | Giá: %-8s%s%s",
                        i,
                        pet.name,
                        pet.gen,
                        pet.rarity,
                        pet.price,
                        pet.mutation ~= "" and " | ✦ " .. pet.mutation or "",
                        pet.stolen and " | 🔴 STOLEN" or ""
                    )
                    print(line)
                end

                -- Tính tổng gen
                local totalGen = 0
                for _, p in ipairs(results) do
                    local num, suffix = p.gen:match("%$([%d%.]+)([KMBTkmbt]?)")
                    num = tonumber(num) or 0
                    local mult = {K=1e3,M=1e6,B=1e9,T=1e12,k=1e3,m=1e6,b=1e9,t=1e12}
                    totalGen = totalGen + num * (mult[suffix] or 1)
                end

                local function fmtNum(n)
                    if n >= 1e12 then return string.format("$%.2fT/s", n/1e12)
                    elseif n >= 1e9  then return string.format("$%.2fB/s", n/1e9)
                    elseif n >= 1e6  then return string.format("$%.2fM/s", n/1e6)
                    elseif n >= 1e3  then return string.format("$%.2fK/s", n/1e3)
                    else return string.format("$%.0f/s", n) end
                end

                print("───────────────────────────────────")
                print("💰 Tổng Gen/s: " .. fmtNum(totalGen))
                print("═══════════════════════════════════")
            end
        end

        task.wait(SCAN_INTERVAL)
    end
end)

