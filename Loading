local function makeCorner(xAnchor, yAnchor, xPos, yPos)
    local corner = Instance.new("Frame")
    corner.Size = UDim2.new(0, 60, 0, 60)
    corner.AnchorPoint = Vector2.new(xAnchor, yAnchor)
    corner.Position = UDim2.new(xPos, 0, yPos, 0)
    corner.BackgroundTransparency = 1
    corner.BorderSizePixel = 0
    corner.ZIndex = 2
    corner.Parent = BG

    local lineH = Instance.new("Frame")
    lineH.Size = UDim2.new(1, 0, 0, 2)
    lineH.BackgroundColor3 = Color3.fromRGB(0, 255, 231)
    lineH.BorderSizePixel = 0
    lineH.BackgroundTransparency = 0.5
    lineH.ZIndex = 2
    if yAnchor == 1 then
        lineH.AnchorPoint = Vector2.new(0, 1)
        lineH.Position = UDim2.new(0, 0, 1, 0)
    end
    lineH.Parent = corner

    local lineV = Instance.new("Frame")
    lineV.Size = UDim2.new(0, 2, 1, 0)
    lineV.BackgroundColor3 = Color3.fromRGB(0, 255, 231)
    lineV.BorderSizePixel = 0
    lineV.BackgroundTransparency = 0.5
    lineV.ZIndex = 2
    if xAnchor == 1 then
        lineV.AnchorPoint = Vector2.new(1, 0)
        lineV.Position = UDim2.new(1, 0, 0, 0)
    end
    lineV.Parent = corner
end

