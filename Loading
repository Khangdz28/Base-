-- ═══════════════════════════════════
-- HÀM CHẠY LOADING 1 → 99%
-- ═══════════════════════════════════
local logs = {
    [1]  = "Đang khởi tạo hệ thống... | Initializing system...",
    [10] = "Tải kernel modules... | Loading kernel modules...",
    [20] = "Kiểm tra bộ nhớ RAM... | Checking RAM memory...",
    [30] = "Khởi động subsystems... | Starting subsystems...",
    [40] = "Nạp cấu hình mạng... | Loading network config...",
    [50] = "Xác thực người dùng... | Authenticating user...",
    [60] = "Tải tài nguyên đồ họa... | Loading graphics assets...",
    [70] = "Đồng bộ dữ liệu... | Synchronizing data...",
    [80] = "Thiết lập kết nối... | Establishing connection...",
    [90] = "Kiểm tra toàn vẹn file... | Verifying file integrity...",
    [95] = "Kết nối máy chủ... | Connecting to server...",
    [97] = "Đang chờ phản hồi... | Waiting for response...",
    [98] = "Timeout... thử lại lần 1... | Timeout... retry 1...",
    [99] = "Timeout... thử lại lần 2... | Timeout... retry 2...",
}

local pingValues = {"12ms","14ms","11ms","18ms","22ms","35ms","67ms","120ms","288ms","999ms","???"}

local function runLoading()
    local pingIdx = 1

    for i = 1, 99 do
        PercentLabel.Text = tostring(i) .. "%"
        TweenService:Create(BarFill, TweenInfo.new(0.12, Enum.EasingStyle.Linear), {
            Size = UDim2.new(i / 100, 0, 1, 0)
        }):Play()

        if logs[i] then LogLabel.Text = logs[i] end

        if i >= 80 then
            pingIdx = math.min(pingIdx + 1, #pingValues)
            PingLabel.Text = "PING: " .. pingValues[pingIdx]
            if i >= 95 then
                PingLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            elseif i >= 90 then
                PingLabel.TextColor3 = Color3.fromRGB(255, 180, 0)
            end
        end

        local delay
        if     i < 30  then delay = 0.20 + math.random() * 0.10   -- ~9s
        elseif i < 60  then delay = 0.25 + math.random() * 0.15   -- ~12s
        elseif i < 80  then delay = 0.35 + math.random() * 0.15   -- ~10s
        elseif i < 90  then delay = 0.50 + math.random() * 0.20   -- ~7s
        elseif i < 95  then delay = 0.70 + math.random() * 0.30   -- ~5s
        elseif i < 98  then delay = 1.00 + math.random() * 0.40   -- ~4s
        else               delay = 1.50 + math.random() * 0.50    -- ~4s
        end

        task.wait(delay)
    end

    -- ══ 99% - HIỆN LỖI MẠNG ══
    PercentLabel.TextColor3 = Color3.fromRGB(255, 43, 78)
    Stroke.Color = Color3.fromRGB(255, 43, 78)
    BarFill.BackgroundColor3 = Color3.fromRGB(255, 43, 78)
    FillGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 10, 30)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 100)),
    })
    StatusLabel.Text = "⚠  KẾT NỐI THẤT BẠI  |  CONNECTION LOST"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 43, 78)
    PingLabel.Text = "PING: LOST"
    LogLabel.Text = "⚠ Mất kết nối đến máy chủ! | Lost connection to server!"
    LogLabel.TextColor3 = Color3.fromRGB(255, 80, 80)

    -- Flash đỏ
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = Color3.fromRGB(255, 0, 30)
    flash.BackgroundTransparency = 0.3
    flash.BorderSizePixel = 0
    flash.ZIndex = 10
    flash.Parent = BG
    TweenService:Create(flash, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 1
    }):Play()
    task.wait(0.6)
    flash:Destroy()

    -- Glitch title
    task.spawn(function()
        local chars = {"█","▓","▒","░","0","1","X","Z","#","@","!","?"}
        for _ = 1, 18 do
            local g = ""
            for c in ("INITIALIZING"):gmatch(".") do
                g ..= math.random() < 0.35 and chars[math.random(#chars)] or c
            end
            Title.Text = g
            task.wait(0.06)
        end
        Title.Text = "INITIALIZING"
        Title.TextColor3 = Color3.fromRGB(255, 43, 78)
    end)

    task.wait(0.4)

    -- Hiện hộp lỗi
    ErrorBox.Visible = true
    ErrorBox.BackgroundTransparency = 1
    ErrStroke.Transparency = 1
    TweenService:Create(ErrorBox, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0
    }):Play()
    TweenService:Create(ErrStroke, TweenInfo.new(0.4), {Transparency = 0.2}):Play()

    -- Pulse hộp lỗi
    local pulseRunning = true
    task.spawn(function()
        while pulseRunning and ErrorBox.Parent do
            TweenService:Create(ErrStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0.7}):Play()
            task.wait(0.8)
            TweenService:Create(ErrStroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0.1}):Play()
            task.wait(0.8)
        end
    end)

    -- Pulse %
    local percentPulse = true
    task.spawn(function()
        while percentPulse and PercentLabel.Parent do
            TweenService:Create(PercentLabel, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextTransparency = 0.65}):Play()
            task.wait(0.7)
            TweenService:Create(PercentLabel, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextTransparency = 0.05}):Play()
            task.wait(0.7)
        end
    end)

    -- ══ ĐẾM NGƯỢC 30 GIÂY ══
    for countdown = 30, 1, -1 do
        ErrRetry.Text = "Thử lại sau: " .. countdown .. "s  |  Retry in: " .. countdown .. "s"
        -- Màu đổi khi gần hết
        if countdown <= 5 then
            ErrRetry.TextColor3 = Color3.fromRGB(255, 80, 80)
        elseif countdown <= 10 then
            ErrRetry.TextColor3 = Color3.fromRGB(255, 150, 50)
        end
        task.wait(1)
    end

    ErrRetry.Text = "Đang kết nối lại...  |  Reconnecting..."
    ErrRetry.TextColor3 = Color3.fromRGB(0, 255, 180)
    ErrCode.Text = "ERROR CODE: NET_TIMEOUT_0x00FF  |  RETRYING..."

    task.wait(1.5)

    -- Dừng pulse
    pulseRunning = false
    percentPulse = false

    -- Fade out hộp lỗi
    TweenService:Create(ErrorBox, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 1
    }):Play()
    task.wait(0.6)

    -- Flash trắng chuyển cảnh
    local flashWhite = Instance.new("Frame")
    flashWhite.Size = UDim2.new(1, 0, 1, 0)
    flashWhite.BackgroundColor3 = Color3.fromRGB(0, 255, 231)
    flashWhite.BackgroundTransparency = 0.5
    flashWhite.BorderSizePixel = 0
    flashWhite.ZIndex = 10
    flashWhite.Parent = BG
    TweenService:Create(flashWhite, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 1
    }):Play()
    task.wait(0.7)
    flashWhite:Destroy()

    -- Reset và chạy lại
    resetToLoading()
    task.wait(0.3)
    runLoading()
end

